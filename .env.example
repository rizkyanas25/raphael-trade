# Raphael AI Bot - Environment Variables
# Copy this file to .env and fill in your actual values

# ─────────────────────────────────────────
# Telegram Configuration
# ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_USER_ID=your_telegram_user_id_here

# ─────────────────────────────────────────
# Gemini AI Configuration
# ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ─────────────────────────────────────────
# MT5 Configuration
# Note: For macOS, mt5-mac automatically finds MT5.app
# ─────────────────────────────────────────
MT5_LOGIN=your_mt5_login
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_mt5_server

# Testing Mode — set true to use mock MT5 without real terminal
USE_MOCK_MT5=false

# ─────────────────────────────────────────
# Risk Management Configuration
# ─────────────────────────────────────────
# Percentage of current EQUITY risked per trade (dynamic, not hardcoded IDR)
# 5.0 = 5% of live equity per trade
RISK_PERCENT_PER_TRADE=5.0

# Hard SKIP threshold multiplier: if actual risk > RISK_PERCENT * this, SKIP
# e.g. 2.0 means hard SKIP only when risk > 10% (2 × 5%)
RISK_HARD_SKIP_MULTIPLIER=2.0

# USD/IDR exchange rate for pip value conversion
USD_IDR_RATE=16000

# Minimum RRR (Risk-to-Reward Ratio)
MIN_RRR=2.0

# Default lot size (minimum tradeable)
DEFAULT_LOT_SIZE=0.01

# Maximum pip value per lot (USD) — standard for most forex pairs
PIP_VALUE_PER_LOT_USD=10.0

# ─────────────────────────────────────────
# High-Volatility Instrument Rules
# ─────────────────────────────────────────
# Minimum equity (IDR) required to trade high-vol instruments (XAU, JPN225, etc.)
# Set to 0 to disable this restriction entirely
HIGH_VOL_MIN_EQUITY_IDR=1000000

# Comma-separated list of high-volatility symbols
HIGH_VOL_SYMBOLS=XAUUSD,XAGUSD,JPN225,US30,NAS100,UK100,GER40

# ─────────────────────────────────────────
# Position Limits
# ─────────────────────────────────────────
MAX_POSITIONS=3
MAX_MARGIN_USAGE_PERCENT=50.0
# Minimum MT5 margin level % before new positions blocked
MIN_MARGIN_LEVEL_PERCENT=500.0

# ─────────────────────────────────────────
# Paper Trading Configuration
# ─────────────────────────────────────────
PAPER_TRADING_ENABLED=true
PAPER_TRADING_WIN_RATE_THRESHOLD=55.0
PAPER_TRADING_RRR_THRESHOLD=2.0

# Auto-monitor interval in seconds (how often to check TP/SL)
PAPER_TRADING_MONITOR_INTERVAL=60

# Auto-expire pending orders that never trigger (days)
PAPER_TRADING_INTRADAY_EXPIRE_DAYS=2
PAPER_TRADING_SWING_EXPIRE_DAYS=5

# Starting virtual equity for paper trading (IDR)
PAPER_TRADING_STARTING_EQUITY_IDR=570000

# ─────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────
DATABASE_PATH=raphael_trades.db

# ─────────────────────────────────────────
# Logging Configuration
# ─────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=raphael.log

# ─────────────────────────────────────────
# Retry Configuration
# ─────────────────────────────────────────
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=5

# ─────────────────────────────────────────
# System Configuration
# ─────────────────────────────────────────
SYSTEM_TIMEZONE=Asia/Jakarta
