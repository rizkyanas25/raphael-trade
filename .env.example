# Raphael AI Bot v2.0 — Environment Variables
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to git.

# ─────────────────────────────────────────
# Telegram
# ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_USER_ID=your_telegram_user_id_here

# ─────────────────────────────────────────
# Gemini AI
# ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ─────────────────────────────────────────
# Bitget Futures API
# Get from: Bitget → API Management → Create API
# Required permissions: Read + Trade (Futures)
# ─────────────────────────────────────────
BITGET_API_KEY=your_bitget_api_key_here
BITGET_API_SECRET=your_bitget_api_secret_here
BITGET_PASSPHRASE=your_bitget_passphrase_here

# Set to true to use Bitget testnet (sandbox) — recommended for first run
BITGET_SANDBOX=false

# ─────────────────────────────────────────
# Risk Management
# ─────────────────────────────────────────
# % of live USDT equity to risk per trade (default 3%)
RISK_PERCENT_PER_TRADE=3.0

# AUTO-SKIP if SL distance from entry > this % (default 1.5%)
MAX_SL_DISTANCE_PERCENT=1.5

# Minimum Risk:Reward Ratio (default 3.0 → 1:3)
MIN_RRR=3.0

# Default leverage for new positions
DEFAULT_LEVERAGE=5

# Hard cap on leverage
MAX_LEVERAGE=10

# ─────────────────────────────────────────
# Watchlist & Scan
# ─────────────────────────────────────────
# Symbols the autonomous scanner will trade
WATCHLIST=SOLUSDT,DOGEUSDT,XRPUSDT,ADAUSDT,TRXUSDT,LTCUSDT,LINKUSDT,AVAXUSDT

# Symbols scanned for H1 bias only — never executed
BIAS_SYMBOLS=BTCUSDT,ETHUSDT

# Autonomous scan interval in seconds (900 = 15 minutes)
SCAN_INTERVAL_SECONDS=900

# ─────────────────────────────────────────
# Position Limits
# ─────────────────────────────────────────
# Max simultaneous active + pending positions (Rule 3: keep at 1)
MAX_POSITIONS=1

# ─────────────────────────────────────────
# Operation Mode
# manual → bot sends signal, you confirm with button
# auto   → bot places Limit Order automatically
# ─────────────────────────────────────────
OPERATION_MODE=manual

# ─────────────────────────────────────────
# Database & Logging
# ─────────────────────────────────────────
DATABASE_PATH=raphael_trades.db
LOG_LEVEL=INFO
LOG_FILE=raphael.log
SYSTEM_TIMEZONE=Asia/Jakarta
